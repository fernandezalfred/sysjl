// Prisma ORM 6 — MongoDB connector.
// Minimal schema to support authentication for now: User + Vehicle,
// enough for login and role checks. Full inventory/sales models are a
// separate feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VEHICLE_USER
}

model User {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String            @unique
  passwordHash String
  role         Role              @default(VEHICLE_USER)
  isActive     Boolean           @default(true)
  vehicle      Vehicle?
  workRecords  DailyWorkRecord[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Vehicle {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  userId    String?  @unique @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One record per user per working day: quantities taken from the deposit
// and remaining at day's end for the two currently-tracked products.
model DailyWorkRecord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime
  quesoTaken      Int
  quesoRemaining  Int
  yogurtTaken     Int
  yogurtRemaining Int
  // Day's grand-total Bs revenue across all 4 products, user-entered. Independent
  // of quesoSold/yogurtSold; not cross-checked against their sum.
  // Default only guards legacy/pre-field documents from breaking reads.
  totalSold       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
}
